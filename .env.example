# Copy to .env and change the secrets. Never commit .env.
ENVIRONMENT=development

POSTGRES_USER=grc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=grc

RUSTFS_ACCESS_KEY=grc-access
RUSTFS_SECRET_KEY=change-me-at-least-8-chars
S3_BUCKET=grc

JWT_SECRET=change-me-to-a-long-random-string

SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me

# Maximum estimated AI spend per assessment run (USD) before guided chat pauses
RUN_AI_BUDGET_USD=3

# Required for AI features (framework parsing, question generation, guided runs)
ANTHROPIC_API_KEY=

FRONTEND_PORT=3000
BACKEND_PORT=8000
