# Copy to .env and change the secrets. Never commit .env.
# "production" refuses to start with placeholder or short secrets, sets Secure cookies and
# turns the API docs off.
ENVIRONMENT=development

POSTGRES_USER=grc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=grc

RUSTFS_ACCESS_KEY=grc-access
RUSTFS_SECRET_KEY=change-me-at-least-8-chars
S3_BUCKET=grc

JWT_SECRET=change-me-to-a-long-random-string

SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me

# Maximum estimated AI spend per assessment run (USD) before guided chat pauses
RUN_AI_BUDGET_USD=3

# Required for AI features (framework parsing, question generation, guided runs).
# Only the AI service reads it.
ANTHROPIC_API_KEY=

# Shared secret between the backend/worker and the AI service. Required when
# ENVIRONMENT=production (at least 24 characters); may be empty in development.
AI_SERVICE_TOKEN=

# Production: how the reverse proxy listens. ":80" serves plain HTTP on any host name;
# a host name (app.example.com) serves that host with automatic HTTPS certificates.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# Development only (docker-compose.dev.yml publishes the frontend and backend directly)
FRONTEND_PORT=3000
BACKEND_PORT=8000
